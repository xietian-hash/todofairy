/* ===== 页面基底 ===== */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 30rpx 140rpx;
  background: #f5f7fa;
  color: #1e293b;
}

/* ===== 拟物公共卡片 ===== */
.calendar-card,
.progress-card,
.todo-card {
  background: #ffffff;
  border-radius: 20rpx;
  border: none;
  box-shadow: 6rpx 6rpx 14rpx rgba(0, 0, 0, 0.07),
    -6rpx -6rpx 14rpx rgba(255, 255, 255, 1);
}

/* ===== 日历区域 ===== */
.calendar-card {
  padding: 20rpx;
}

.calendar-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.month-btn {
  width: 72rpx;
  min-width: 72rpx;
  max-width: 72rpx;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  margin: 0;
  flex: 0 0 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  background: #ffffff;
  color: #21bfff;
  font-size: 40rpx;
  text-align: center;
  box-shadow: 6rpx 6rpx 14rpx rgba(0, 0, 0, 0.07),
    -6rpx -6rpx 14rpx rgba(255, 255, 255, 1);
}

.month-btn:active {
  box-shadow: inset 4rpx 4rpx 8rpx rgba(0, 0, 0, 0.08),
    inset -4rpx -4rpx 8rpx rgba(255, 255, 255, 1);
}

.month-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
}

.week-row {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  color: #64748b;
  font-size: 22rpx;
}

.day-grid {
  margin-top: 12rpx;
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
}

/* ===== 日历格子（拟物） ===== */
.day-cell {
  height: 72rpx;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  background: #ffffff;
  box-shadow: 3rpx 3rpx 7rpx rgba(0, 0, 0, 0.05),
    -3rpx -3rpx 7rpx rgba(255, 255, 255, 1);
  position: relative;
}

.day-cell.empty {
  background: transparent;
  box-shadow: none;
}

.day-cell.today .today-dot {
  display: block;
}

.today-dot {
  display: none;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #21bfff;
  margin-top: 2rpx;
}

.day-cell.selected {
  background: linear-gradient(135deg, #e0f5ff, #ede9fe);
  font-weight: 600;
  border: 2rpx solid #21bfff;
  box-shadow: inset 4rpx 4rpx 8rpx rgba(0, 0, 0, 0.08),
    inset -4rpx -4rpx 8rpx rgba(255, 255, 255, 1);
}

/* ===== 日历四态 ===== */
.status-completed {
  background: #bae6fd;
}

.status-history_uncompleted {
  background: #fecaca;
}

.status-today_uncompleted {
  background: #fde68a;
}

.status-no_todo {
  background: #f1f5f9;
}

/* ===== 进度卡片 ===== */
.progress-card {
  margin-top: 24rpx;
  padding: 20rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #1e293b;
}

.progress-count {
  font-size: 24rpx;
  font-weight: 600;
  color: #21bfff;
}

.progress-track {
  height: 16rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: inset 4rpx 4rpx 8rpx rgba(0, 0, 0, 0.08),
    inset -4rpx -4rpx 8rpx rgba(255, 255, 255, 1);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #21bfff, #6c5ce7);
  transition: width 0.3s ease;
}

/* ===== 待办列表 ===== */
.todo-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.todo-card {
  padding: 20rpx;
  padding-left: 24rpx;
  border-left: 4rpx solid #21bfff;
  transition: box-shadow 0.15s ease;
}

.todo-card:active {
  box-shadow: inset 4rpx 4rpx 8rpx rgba(0, 0, 0, 0.08),
    inset -4rpx -4rpx 8rpx rgba(255, 255, 255, 1);
}

.todo-card.done {
  background: #f0fdfa;
  border-left-color: #10b981;
}

.todo-card.expired {
  border-left-color: #94a3b8;
}

.todo-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* ===== 勾选框（拟物） ===== */
.check-btn {
  margin: 0;
  width: 44rpx;
  min-width: 44rpx;
  max-width: 44rpx;
  height: 44rpx;
  min-height: 44rpx;
  max-height: 44rpx;
  flex: 0 0 44rpx;
  border-radius: 22rpx;
  border: none;
  background: #ffffff;
  color: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 1;
  padding: 0;
  box-shadow: inset 4rpx 4rpx 8rpx rgba(0, 0, 0, 0.08),
    inset -4rpx -4rpx 8rpx rgba(255, 255, 255, 1);
  transition: box-shadow 0.2s ease, background 0.2s ease;
}

.check-btn.checked {
  background: linear-gradient(135deg, #21bfff, #6c5ce7);
  color: #ffffff;
  box-shadow: 6rpx 6rpx 14rpx rgba(0, 0, 0, 0.07),
    -6rpx -6rpx 14rpx rgba(255, 255, 255, 1);
}

/* ===== 待办内容行 ===== */
.todo-content-row {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.todo-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.todo-card.done .todo-title {
  text-decoration: line-through;
  color: #64748b;
}

.expired-tag {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  height: 40rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: #fee2e2;
  color: #b91c1c;
}

/* ===== 空态 ===== */
.empty-state {
  margin-top: 30rpx;
  padding: 60rpx 20rpx;
  border-radius: 20rpx;
  text-align: center;
  background: #ffffff;
  border: none;
  box-shadow: inset 4rpx 4rpx 8rpx rgba(0, 0, 0, 0.05),
    inset -4rpx -4rpx 8rpx rgba(255, 255, 255, 1);
}

.empty-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1e293b;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #64748b;
}

/* ===== 底部新建任务按钮（浮雕） ===== */
.bottom-bar {
  position: fixed;
  left: 30rpx;
  right: 30rpx;
  bottom: 26rpx;
}

.create-btn {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  border-radius: 60rpx;
  background: linear-gradient(135deg, #21bfff, #6c5ce7);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: 6rpx 6rpx 14rpx rgba(0, 0, 0, 0.07),
    -6rpx -6rpx 14rpx rgba(255, 255, 255, 1);
  transition: box-shadow 0.15s ease;
}

.create-btn:active {
  background: linear-gradient(135deg, #0ea5e9, #5b4bd5);
  box-shadow: inset 4rpx 4rpx 8rpx rgba(0, 0, 0, 0.08),
    inset -4rpx -4rpx 8rpx rgba(255, 255, 255, 1);
}

/* ===== 弹窗遮罩 ===== */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 9999;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  padding: 0;
  box-sizing: border-box;
}

.modal-panel {
  width: 100%;
  height: 80vh;
  max-height: 80vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  box-sizing: border-box;
}

/* ===== 弹窗头部 ===== */
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx 12rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
}

.close-btn {
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  min-height: 72rpx;
  max-width: 72rpx;
  max-height: 72rpx;
  padding: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
  line-height: 1;
  background: #ffffff;
  font-size: 38rpx;
  color: #64748b;
  box-shadow: 6rpx 6rpx 14rpx rgba(0, 0, 0, 0.07),
    -6rpx -6rpx 14rpx rgba(255, 255, 255, 1);
}

.close-btn:active {
  box-shadow: inset 4rpx 4rpx 8rpx rgba(0, 0, 0, 0.08),
    inset -4rpx -4rpx 8rpx rgba(255, 255, 255, 1);
}

/* ===== 弹窗内容区 ===== */
.modal-body {
  flex: 1;
  overflow: hidden;
  padding: 0 30rpx;
  box-sizing: border-box;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.modal-body::-webkit-scrollbar {
  width: 0;
  height: 0;
}

/* ===== 表单项 ===== */
.form-item {
  margin-top: 16rpx;
}

.form-item.row {
  display: flex;
  gap: 16rpx;
}

.form-item.align-center {
  align-items: center;
  justify-content: space-between;
}

.half {
  flex: 1;
}

.label {
  font-size: 24rpx;
  color: #64748b;
}

/* ===== 输入框（拟物凹陷） ===== */
.input,
.picker,
.textarea {
  margin-top: 8rpx;
  border: none;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #1e293b;
  min-height: 80rpx;
  background: #ffffff;
  box-shadow: inset 4rpx 4rpx 8rpx rgba(0, 0, 0, 0.08),
    inset -4rpx -4rpx 8rpx rgba(255, 255, 255, 1);
}

.input:focus,
.textarea:focus {
  box-shadow: inset 4rpx 4rpx 10rpx rgba(0, 0, 0, 0.1),
    inset -4rpx -4rpx 10rpx rgba(255, 255, 255, 1);
}

.picker.disabled {
  background: #f1f5f9;
  color: #94a3b8;
}

.textarea {
  width: 100%;
  min-height: 140rpx;
}

.radio-item {
  margin-left: 16rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #1e293b;
}

/* ===== 弹窗底部按钮（拟物） ===== */
.modal-actions {
  flex-shrink: 0;
  display: flex;
  gap: 12rpx;
  padding: 16rpx 30rpx 24rpx;
  box-sizing: border-box;
  border-top: none;
  background: #ffffff;
}

.ghost-btn,
.primary-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  border-radius: 48rpx;
  font-size: 28rpx;
  transition: box-shadow 0.15s ease;
}

.ghost-btn {
  background: #ffffff;
  border: none;
  color: #21bfff;
  box-shadow: 6rpx 6rpx 14rpx rgba(0, 0, 0, 0.07),
    -6rpx -6rpx 14rpx rgba(255, 255, 255, 1);
}

.ghost-btn:active {
  box-shadow: inset 4rpx 4rpx 8rpx rgba(0, 0, 0, 0.08),
    inset -4rpx -4rpx 8rpx rgba(255, 255, 255, 1);
}

.primary-btn {
  background: linear-gradient(135deg, #21bfff, #6c5ce7);
  color: #ffffff;
  box-shadow: 6rpx 6rpx 14rpx rgba(0, 0, 0, 0.07),
    -6rpx -6rpx 14rpx rgba(255, 255, 255, 1);
}

.primary-btn:active {
  background: linear-gradient(135deg, #0ea5e9, #5b4bd5);
  box-shadow: inset 4rpx 4rpx 8rpx rgba(0, 0, 0, 0.08),
    inset -4rpx -4rpx 8rpx rgba(255, 255, 255, 1);
}

/* ===== 错误提示条 ===== */
.error-bar {
  position: fixed;
  left: 30rpx;
  right: 30rpx;
  bottom: 130rpx;
  min-height: 72rpx;
  border-radius: 20rpx;
  background: #fee2e2;
  color: #b91c1c;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 6rpx 6rpx 14rpx rgba(0, 0, 0, 0.07),
    -6rpx -6rpx 14rpx rgba(255, 255, 255, 1);
}
