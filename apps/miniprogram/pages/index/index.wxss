.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 30rpx 140rpx;
  background: #e8f4f8;
  color: #1f2937;
}

.calendar-card,
.progress-card,
.todo-card {
  background: #ffffff;
  border-radius: 16rpx;
  border: 1rpx solid #dce7ee;
}

.calendar-card {
  padding: 20rpx;
}

.calendar-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.month-btn {
  width: 72rpx;
  min-width: 72rpx;
  max-width: 72rpx;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  margin: 0;
  flex: 0 0 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  background: #f5fbfe;
  color: #4299e1;
  font-size: 40rpx;
  text-align: center;
}

.month-text {
  font-size: 30rpx;
  font-weight: 500;
}

.week-row {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  color: #64748b;
  font-size: 22rpx;
}

.day-grid {
  margin-top: 12rpx;
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
}

.day-cell {
  height: 72rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.day-cell.empty {
  background: transparent;
}

.day-cell.today {
  box-shadow: inset 0 0 0 2rpx #4299e1;
}

.day-cell.selected {
  box-shadow: inset 0 0 0 2rpx #1d4ed8;
  font-weight: 600;
}

.status-completed {
  background: #dcfce7;
}

.status-history_uncompleted {
  background: #fee2e2;
}

.status-today_uncompleted {
  background: #fef3c7;
}

.status-no_todo {
  background: #e2e8f0;
}

.progress-card {
  margin-top: 24rpx;
  padding: 20rpx;
}

.progress-inline {
  font-size: 26rpx;
  font-weight: 500;
  color: #334155;
}

.todo-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.todo-card {
  padding: 20rpx;
}

.todo-card.done {
  background: #f0fdf4;
}

.todo-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.check-btn {
  margin: 0;
  width: 40rpx;
  min-width: 40rpx;
  max-width: 40rpx;
  height: 40rpx;
  min-height: 40rpx;
  max-height: 40rpx;
  flex: 0 0 40rpx;
  border-radius: 20rpx;
  border: 2rpx solid #cbd5e1;
  background: #ffffff;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 1;
  padding: 0;
}

.check-btn.checked {
  background: #10b981;
  border-color: #10b981;
  color: #ffffff;
}

.todo-content-row {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.todo-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.expired-tag {
  display: inline-flex;
  flex: 0 0 auto;
  align-items: center;
  height: 40rpx;
  padding: 0 12rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: #fee2e2;
  color: #b91c1c;
}

.empty-state {
  margin-top: 30rpx;
  padding: 60rpx 20rpx;
  border-radius: 16rpx;
  text-align: center;
  background: #ffffff;
  border: 1rpx dashed #dce7ee;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 500;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #64748b;
}

.bottom-bar {
  position: fixed;
  left: 30rpx;
  right: 30rpx;
  bottom: 26rpx;
}

.create-btn {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  border-radius: 60rpx;
  background: #4299e1;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 500;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: transparent;
  z-index: 9999;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  padding: 0;
  box-sizing: border-box;
}

.modal-panel {
  width: 100%;
  height: 80vh;
  max-height: 80vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx 12rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.modal-body {
  flex: 1;
  overflow: hidden;
  padding: 0 30rpx;
  box-sizing: border-box;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.modal-body::-webkit-scrollbar {
  width: 0;
  height: 0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
}

.close-btn {
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  min-height: 72rpx;
  max-width: 72rpx;
  max-height: 72rpx;
  padding: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
  line-height: 1;
  background: #f1f5f9;
  font-size: 38rpx;
  color: #64748b;
}

.form-item {
  margin-top: 16rpx;
}

.form-item.row {
  display: flex;
  gap: 16rpx;
}

.form-item.align-center {
  align-items: center;
  justify-content: space-between;
}

.half {
  flex: 1;
}

.label {
  font-size: 24rpx;
  color: #64748b;
}

.input,
.picker,
.textarea {
  margin-top: 8rpx;
  border: 1rpx solid #dce7ee;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #1f2937;
  min-height: 80rpx;
  background: #ffffff;
}

.picker.disabled {
  background: #f1f5f9;
  color: #94a3b8;
}

.textarea {
  width: 100%;
  min-height: 140rpx;
}

.radio-item {
  margin-left: 16rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #334155;
}

.modal-actions {
  flex-shrink: 0;
  display: flex;
  gap: 12rpx;
  padding: 16rpx 30rpx 24rpx;
  box-sizing: border-box;
  border-top: 1rpx solid #e2e8f0;
  background: #ffffff;
}

.ghost-btn,
.primary-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  border-radius: 48rpx;
  font-size: 28rpx;
}

.ghost-btn {
  background: #ffffff;
  border: 1rpx solid #4299e1;
  color: #4299e1;
}

.primary-btn {
  background: #4299e1;
  color: #ffffff;
}

.error-bar {
  position: fixed;
  left: 30rpx;
  right: 30rpx;
  bottom: 130rpx;
  min-height: 72rpx;
  border-radius: 12rpx;
  background: #fee2e2;
  color: #b91c1c;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
